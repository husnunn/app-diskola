<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (`android:dataExtractionRules`): same rule for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="akm_exam_state.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="akm_exam_state.xml" />
    </device-transfer>
</data-extraction-rules>
