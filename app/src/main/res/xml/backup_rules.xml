<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older (`android:fullBackupContent`). Everything is backed up as before except the exam session flags: a marker
     restored onto another phone would claim an exam session that never ran there (`AkmExamState`). -->
<full-backup-content>
    <exclude domain="sharedpref" path="akm_exam_state.xml" />
</full-backup-content>
