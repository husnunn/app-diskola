<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MVVM" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand (use reference palette) -->
        <item name="colorPrimary">@color/ref_primary</item>
        <item name="colorPrimaryVariant">@color/ref_primary_container</item>
        <item name="colorSecondary">@color/ref_secondary</item>
        <item name="colorSecondaryVariant">@color/ref_secondary_container</item>

        <!-- Surfaces -->
        <item name="colorSurface">@color/ref_surface</item>
        <item name="colorOnSurface">@color/ref_on_surface</item>
        <item name="android:colorBackground">@color/ref_background</item>
        <item name="colorOnBackground">@color/ref_on_surface</item>

        <!-- On colors (ensure contrast) -->
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- System bars -->
        <!-- The app is edge-to-edge: MainActivity calls enableEdgeToEdge(), which makes both bars transparent at runtime.
             These values only show before that runs (cold start), so they match it: transparent bars over the light
             window background, dark icons. A coloured status bar here flashed green on launch. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/ref_background</item>
        <!-- The app is light-only: opt out of the OEM "force dark" that darkens apps with a light theme (API 29+, ignored below). -->
        <item name="android:forceDarkAllowed">false</item>

        <!-- Material widgets -->
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="textInputStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox</item>
    </style>

</resources>
